{
  "permissions": {
    "allow": [
      "Bash(docker compose exec -T app php artisan test*)",
      "Bash(docker compose exec -T app vendor/bin/pint*)",
      "Bash(docker compose exec -T app php artisan migrate*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(curl -s -o /dev/null -w * http://localhost:8081/*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-destructive-db.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pint-on-edit.sh"
          }
        ]
      }
    ]
  }
}
